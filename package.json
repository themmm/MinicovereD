{
  "name": "minicovered",
  "version": "1.0.0",
  "private": true,
  "description": "Design and print MiniDisc case Inserts and cartridge Labels as print-accurate PDFs.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run build:pwa && npm run build:singlefile",
    "build:pwa": "vite build",
    "build:singlefile": "vite build --mode singlefile",
    "preview": "vite preview --outDir dist/pwa",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/archivo-narrow": "5.3.0",
    "@fontsource-variable/bitter": "5.3.0",
    "@fontsource-variable/cabin": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/noto-sans": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/noto-sans-jp": "5.3.0",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "4.1.11"
  }
}
