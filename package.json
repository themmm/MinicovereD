{
  "name": "mdcovergen",
  "version": "0.1.0",
  "private": true,
  "description": "Design and print MiniDisc J-Cards, Back Cards and cartridge Labels as print-accurate PDFs.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pwa": "vite build",
    "build:singlefile": "vite build --mode singlefile",
    "build:all": "npm run build:pwa && npm run build:singlefile",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "5.3.0",
    "@fontsource/noto-sans-jp": "5.3.0",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "4.1.11"
  }
}
